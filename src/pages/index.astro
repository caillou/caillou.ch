---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { edgeTint } from "../utils/edge-tint";

// Read the original source asset (portrait.src is an emitted/hashed URL, not a
// path sharp can open). The path is relative to the project root, which is the
// cwd during astro build. Runs at build time only (static output).
const portraitPath = "src/assets/portrait.jpg";
const bgColor = await edgeTint(portraitPath);
---

<BaseLayout title="caillou.ch">
  <Header transparent />

  <Picture
    src={portrait}
    alt="Pierre Spring"
    class="fixed inset-0 -z-10 h-full w-full object-cover"
    widths={[800, 1600, 2400, 3200]}
    formats={["avif", "webp"]}
    quality={80}
  />

  <main></main>

  <!-- iOS Safari tints its status bar / toolbar to the page background color.
       Derived from the portrait's dark top and bottom edges so those bars blend
       instead of going white. See src/utils/edge-tint.ts. -->
  <style is:global set:html={`body{background-color:${bgColor}}`}></style>
</BaseLayout>
