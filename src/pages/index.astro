---
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.jpg";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="caillou.ch">
  <Header transparent />

  <Picture
    src={portrait}
    alt="Pierre Spring"
    class="fixed inset-0 -z-10 h-full w-full object-cover"
    widths={[800, 1600, 2400, 3200]}
    formats={["avif", "webp"]}
    quality={80}
  />

  <main></main>

  <!-- iOS Safari tints its status bar / toolbar to the page background color.
       Match the portrait's dark edge so those bars blend instead of going white. -->
  <style is:global>
    body {
      background-color: #1b1f1d;
    }
  </style>
</BaseLayout>
