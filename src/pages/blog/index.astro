---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import TagList from "../../components/TagList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Blog — caillou.ch">
  <Header />

  <main class="grow px-6 pt-32 pb-24">
    <div class="mx-auto max-w-3xl">
      <div class="mt-12 space-y-8">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="group block pb-8">
              <div class="text-sm font-bold tracking-widest text-outline uppercase italic">
                {post.data.date.toISOString().slice(0, 10)}
              </div>
              <h2 class="mt-2 ml-[2ch] text-xl font-bold text-primary italic transition-colors group-hover:text-tertiary before:ml-[-2ch] before:text-outline before:content-['#_']">
                {post.data.title}
              </h2>
              {post.data.description && (
                <>
                  <p class="mt-2 text-sm leading-relaxed font-bold">
                    {post.data.description}
                  </p>
                </>
              )}
              {post.data.tags.length > 0 && (
                <div class="mt-4">
                  <TagList tags={post.data.tags} />
                </div>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
