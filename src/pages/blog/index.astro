---
import { getCollection } from "astro:content";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import TagList from "../../components/TagList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Blog — caillou.ch">
  <Header />

  <main class="subgrid-cols pt-32 pb-24">
    <div class="col-main">
      <div class="mt-12 space-y-8">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="group block pb-8">
              <div class="text-sm font-bold tracking-widest text-gray uppercase italic">
                {post.data.date.toISOString().slice(0, 10)}
              </div>
              <h2 class="relative mt-2 pl-[2ch] text-xl text-pretty text-yellow italic transition-colors group-hover:text-pink before:absolute before:left-0 before:text-gray before:content-['#_']">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="mt-2 text-sm leading-relaxed">
                  {post.data.description}
                </p>
              )}
              {post.data.tags.length > 0 && (
                <div class="mt-4">
                  <TagList tags={post.data.tags} />
                </div>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
