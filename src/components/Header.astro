---
interface Props {
  transparent?: boolean;
}

const { transparent } = Astro.props;
const pathname = Astro.url.pathname;
---

<header
  class:list={[
    "fixed top-0 right-0 left-0 z-50",
    // todo blur has a hard cut at the bottom. that does not look good.
    transparent ? "" : "backdrop-blur-md",
  ]}
>
  <div class="mx-auto flex max-w-4xl items-center justify-end px-6 py-6">
    <nav class="flex space-x-8 italic">
      <a
        href="/blog"
        class:list={[
          "transition-colors hover:text-tertiary",
          "before:text-outline before:content-['#_']",
          pathname.startsWith("/blog") ? "text-secondary" : "text-on-surface",
        ]}
      >
        Blog
      </a>
      <a
        href="/about"
        class:list={[
          "transition-colors hover:text-tertiary",
          "before:text-outline before:content-['#_']",
          pathname.startsWith("/about") ? "text-secondary" : "text-on-surface",
        ]}
      >
        About
      </a>
    </nav>
  </div>
</header>
