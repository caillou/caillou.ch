---
interface Props {
  transparent?: boolean;
}

const { transparent } = Astro.props;
const pathname = Astro.url.pathname;
---

<header
  class:list={[
    "fixed top-0 right-0 left-0 z-50",
    transparent
      ? ""
      : "border-b border-white/5 bg-black/80 backdrop-blur-md",
  ]}
>
  <div class="mx-auto flex max-w-4xl items-center justify-end px-6 py-6">
    <nav class="flex space-x-8 text-[0.8125rem] font-bold">
      <a
        href="/blog/"
        class:list={[
          "transition-colors hover:text-tertiary",
          "before:text-outline before:content-['#_']",
          pathname.startsWith("/blog") &&
          !pathname.startsWith("/blog/2026-02-12-about")
            ? "text-secondary"
            : "text-on-surface",
        ]}
      >
        Blog
      </a>
      <a
        href="/blog/2026-02-12-about"
        class:list={[
          "transition-colors hover:text-tertiary",
          "before:text-outline before:content-['#_']",
          pathname.startsWith("/blog/2026-02-12-about")
            ? "text-secondary"
            : "text-on-surface",
        ]}
      >
        About
      </a>
    </nav>
  </div>
</header>
