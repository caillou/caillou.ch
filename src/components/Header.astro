---
interface Props {
  transparent?: boolean;
}

const { transparent } = Astro.props;
const pathname = Astro.url.pathname;
---

{
  !transparent && (
    <div
      class:list={[
        "pointer-events-none fixed top-0 right-0 left-0 h-[4.4rem] bg-linear-to-b from-black via-black/60 to-transparent",
        "z-10", // this ensures the gradient is below the header and figures, but above the page content
        "2xl:hidden", // on larger screens the gradient is not needed, because the navigation is on the right side of the content
      ]}
      aria-hidden="true"
    />
  )
}

<header class="pointer-events-none fixed top-0 right-0 left-0 z-50 py-6">
  <nav class="pointer-events-auto flex space-x-8 italic">
    <a
      href="/blog"
      class:list={[
        "transition-colors hover:text-pink",
        "before:text-gray before:content-['#_']",
        pathname.startsWith("/blog") ? "text-green" : "text-white",
      ]}
    >
      Blog
    </a>
    <a
      href="/about"
      class:list={[
        "transition-colors hover:text-pink",
        "before:text-gray before:content-['#_']",
        pathname.startsWith("/about") ? "text-green" : "text-white",
      ]}
    >
      About
    </a>
  </nav>
</header>
