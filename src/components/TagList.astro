---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const colors = ["text-pink", "text-green", "text-yellow"];
---

{
  tags.length > 0 && (
    <div class="flex flex-wrap gap-3">
      {tags.map((tag, i) => (
        <span
          class:list={[
            "bg-dark-gray px-3 py-1 text-sm font-bold tracking-wider italic",
            colors[i % colors.length],
          ]}
        >
          #{tag}
        </span>
      ))}
    </div>
  )
}
