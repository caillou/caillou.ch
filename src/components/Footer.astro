---
interface Props {
  compact?: boolean;
  fixed?: boolean;
}

const { compact, fixed } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class:list={[
    "border-t border-white/5 bg-black",
    compact ? "py-6" : "py-16",
    fixed && "fixed right-0 bottom-0 left-0",
  ]}
>
  <div
    class:list={[
      "mx-auto flex w-full max-w-4xl flex-col items-center px-6 italic md:flex-row md:justify-between",
      compact ? "gap-y-6" : "space-y-10 md:space-y-0",
    ]}
  >
    <div class="text-sm tracking-widest text-outline uppercase">
      &copy;{year} Pierre Spring
    </div>
    <div class="flex space-x-10">
      <a
        href="https://github.com/caillou/caillou.ch"
        class="text-sm tracking-widest text-outline uppercase transition-colors hover:text-on-surface"
      >
        // source
      </a>
      <a
        href="/rss.xml"
        class="text-sm tracking-widest text-outline uppercase transition-colors hover:text-on-surface"
      >
        // rss
      </a>
    </div>
    <a href="/" class:list={[compact && "max-md:hidden"]}>
      <div class="text-primary transition-colors hover:text-tertiary">
        caillou.ch
      </div>
    </a>
  </div>
</footer>
