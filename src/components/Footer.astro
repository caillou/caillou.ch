---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-black py-16">
  <div
    class="mx-auto flex w-full max-w-4xl flex-col items-center space-y-10 px-6 md:flex-row md:justify-between md:space-y-0"
  >
    <div
      class="text-[0.625rem] font-mono uppercase tracking-widest text-outline"
    >
      &copy; {year} caillou.ch
    </div>
    <div class="flex space-x-10">
      <a
        href="https://github.com/caillou"
        class="text-[0.625rem] font-mono uppercase tracking-widest text-outline transition-colors hover:text-on-surface"
      >
        // source
      </a>
      <a
        href="/rss.xml"
        class="text-[0.625rem] font-mono uppercase tracking-widest text-outline transition-colors hover:text-on-surface"
      >
        // rss
      </a>
    </div>
    <div class="text-sm italic text-primary">caillou.ch</div>
  </div>
</footer>
