---
const year = new Date().getFullYear();
---

<footer class="col-full py-16">
  <div
    class:list={[
      "mx-auto flex w-full flex-col items-center px-6 italic md:flex-row md:justify-between",
      "max-w-4xl 2xl:max-w-6xl", // aligns with the header navigation
      "space-y-10 md:space-y-0",
    ]}
  >
    <div class="text-sm tracking-widest text-gray uppercase">
      &copy;{year} Pierre Spring
    </div>
    <div class="flex space-x-10">
      <a
        href="https://github.com/caillou/caillou.ch"
        class="text-sm tracking-widest text-gray uppercase transition-colors hover:text-white"
      >
        // source
      </a>
      <a
        href="/rss.xml"
        class="text-sm tracking-widest text-gray uppercase transition-colors hover:text-white"
      >
        // rss
      </a>
    </div>
    <a href="/">
      <div class="text-yellow transition-colors hover:text-pink">
        caillou.ch
      </div>
    </a>
  </div>
</footer>
