---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 bg-black py-16">
  <div
    class="mx-auto flex w-full max-w-4xl flex-col items-center space-y-10 px-6 md:flex-row md:justify-between md:space-y-0"
  >
    <div
      class="font-mono text-[0.625rem] tracking-widest text-outline uppercase"
    >
      &copy; {year} Pierre Spring.
    </div>
    <div class="flex space-x-10">
      <a
        href="https://github.com/caillou"
        class="font-mono text-[0.625rem] tracking-widest text-outline uppercase transition-colors hover:text-on-surface"
      >
        // source
      </a>
      <a
        href="/rss.xml"
        class="font-mono text-[0.625rem] tracking-widest text-outline uppercase transition-colors hover:text-on-surface"
      >
        // rss
      </a>
    </div>
    <a href="/">
      <div
        class="text-sm text-primary italic transition-colors hover:text-tertiary"
      >
        caillou.ch
      </div></a
    >
  </div>
</footer>
