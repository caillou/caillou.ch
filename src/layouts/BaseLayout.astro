---
import "../styles/global.css";
import latin200italic from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-200-italic.woff2?url";
import latin200normal from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-200-normal.woff2?url";
import latin300italic from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-300-italic.woff2?url";
import latin300normal from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-300-normal.woff2?url";
import latin400italic from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-italic.woff2?url";
import latin400normal from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import latin500italic from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-italic.woff2?url";
import latin500normal from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";
import latin600italic from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-italic.woff2?url";
import latin600normal from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <!-- Standard DPI: normal=400, bold=600 -->
    <link
      rel="preload"
      href={latin400normal}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution < 2dppx)"
    />
    <link
      rel="preload"
      href={latin400italic}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution < 2dppx)"
    />
    <link
      rel="preload"
      href={latin600normal}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution < 2dppx)"
    />
    <link
      rel="preload"
      href={latin600italic}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution < 2dppx)"
    />
    <!-- 2dppx: normal=300, bold=500 -->
    <link
      rel="preload"
      href={latin300normal}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 2dppx) and (resolution < 3dppx)"
    />
    <link
      rel="preload"
      href={latin300italic}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 2dppx) and (resolution < 3dppx)"
    />
    <link
      rel="preload"
      href={latin500normal}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 2dppx) and (resolution < 3dppx)"
    />
    <link
      rel="preload"
      href={latin500italic}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 2dppx) and (resolution < 3dppx)"
    />
    <!-- 3dppx+: normal=200, bold=400 -->
    <link
      rel="preload"
      href={latin200normal}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 3dppx)"
    />
    <link
      rel="preload"
      href={latin200italic}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 3dppx)"
    />
    <link
      rel="preload"
      href={latin400normal}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 3dppx)"
    />
    <link
      rel="preload"
      href={latin400italic}
      as="font"
      type="font/woff2"
      crossorigin
      media="(resolution >= 3dppx)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
